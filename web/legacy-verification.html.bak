<!doctype html>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Relay</title>
<style>
  :root { --bg:#0f1115; --card:#1a1d24; --ink:#e6e8ec; --muted:#9aa3af; --acc:#5b8cff; --line:#2a2f3a; }
  * { box-sizing: border-box; }
  body { margin:0; font:15px/1.5 system-ui,sans-serif; background:var(--bg); color:var(--ink); }
  header { padding:12px 20px; border-bottom:1px solid var(--line); display:flex; gap:12px; align-items:center; }
  header b { color:var(--acc); }
  main { max-width:1100px; margin:0 auto; padding:20px; display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:16px; }
  .card h2 { margin:0 0 10px; font-size:14px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); }
  input, textarea, select, button { font:inherit; }
  input, textarea, select { width:100%; background:#12151b; border:1px solid var(--line); color:var(--ink); border-radius:7px; padding:8px 10px; margin:4px 0; }
  button { background:var(--acc); color:#fff; border:0; border-radius:7px; padding:8px 12px; cursor:pointer; margin:4px 4px 4px 0; }
  button.ghost { background:transparent; border:1px solid var(--line); color:var(--ink); }
  .row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .muted { color:var(--muted); font-size:13px; }
  pre { background:#0c0e12; border:1px solid var(--line); border-radius:7px; padding:10px; overflow:auto; max-height:280px; font-size:12px; }
  .item { border:1px solid var(--line); border-radius:8px; padding:10px; margin:6px 0; }
  .full { grid-column:1 / -1; }
  .pill { font-size:11px; padding:2px 8px; border:1px solid var(--line); border-radius:999px; color:var(--muted); }
  a { color:var(--acc); }
</style>

<header>
  <b>Relay</b> <span class="muted">responsibility-transfer engine — minimal client</span>
  <span style="flex:1"></span>
  <input id="api" style="width:260px" value="http://localhost:8000" title="API base URL" />
  <span id="who" class="muted"></span>
</header>

<main>
  <section class="card" id="authCard">
    <h2>1 · Account</h2>
    <input id="email" placeholder="email" />
    <input id="password" type="password" placeholder="password (8+ chars)" />
    <input id="name" placeholder="display name (register only)" />
    <div class="row">
      <button onclick="register()">Register</button>
      <button class="ghost" onclick="login()">Login</button>
      <button class="ghost" onclick="logout()">Logout</button>
    </div>
    <div class="muted">Tip: open this page in two browsers/profiles to act as two users.</div>
  </section>

  <section class="card">
    <h2>2 · Household</h2>
    <input id="hhName" placeholder="household name" />
    <div class="row"><button onclick="createHousehold()">Create household</button></div>
    <select id="hhSelect" onchange="onHousehold()"></select>
    <div class="row">
      <button class="ghost" onclick="createInvite()">Create invite</button>
      <input id="inviteToken" placeholder="invite token to accept" />
      <button class="ghost" onclick="acceptInvite()">Accept invite</button>
    </div>
    <div id="members" class="muted"></div>
  </section>

  <section class="card">
    <h2>3 · Capture → X-Ray</h2>
    <textarea id="capture" rows="2" placeholder="e.g. Take Maya to the dentist next month"></textarea>
    <div class="row"><button onclick="draft()">Draft with AI/fallback</button></div>
    <div id="draftBox"></div>
  </section>

  <section class="card">
    <h2>4 · My Load (Ghost Queue) & Notifications</h2>
    <div class="row"><button class="ghost" onclick="refreshMe()">Refresh</button></div>
    <div id="queue"></div>
    <div id="notes"></div>
  </section>

  <section class="card full">
    <h2>5 · Responsibilities</h2>
    <div class="row"><button class="ghost" onclick="listResp()">Refresh list</button></div>
    <div id="respList"></div>
    <div id="detail"></div>
  </section>
</main>

<script>
const $ = (id) => document.getElementById(id);
const api = () => $("api").value.replace(/\/$/, "");
let TOKEN = localStorage.getItem("relay_token") || "";
let HH = null;

function setToken(t){ TOKEN=t||""; if(t) localStorage.setItem("relay_token",t); else localStorage.removeItem("relay_token"); who(); }
async function who(){
  $("who").textContent = TOKEN ? "…" : "not signed in";
  if(!TOKEN) return;
  const me = await call("GET","/v1/me").catch(()=>null);
  $("who").textContent = me ? ("signed in: "+me.email) : "session invalid";
}
async function call(method, path, body){
  const res = await fetch(api()+path, {
    method,
    headers: Object.assign({"Content-Type":"application/json"}, TOKEN?{"Authorization":"Bearer "+TOKEN}:{}),
    body: body?JSON.stringify(body):undefined,
  });
  const txt = await res.text();
  const data = txt?JSON.parse(txt):null;
  if(!res.ok) throw Object.assign(new Error(data&&data.detail||res.statusText), {status:res.status, data});
  return data;
}
const show = (id,html) => $(id).innerHTML = html;
const esc = (s)=> (s==null?"":String(s)).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));

async function register(){
  try{ const r = await call("POST","/v1/auth/register",{email:$("email").value,password:$("password").value,display_name:$("name").value||"User"});
    setToken(r.access_token); await loadHouseholds(); alert("Registered + signed in"); }catch(e){ alert("Register failed: "+e.message); }
}
async function login(){
  try{ const r = await call("POST","/v1/auth/login",{email:$("email").value,password:$("password").value});
    setToken(r.access_token); await loadHouseholds(); }catch(e){ alert("Login failed: "+e.message); }
}
async function logout(){ try{ await call("POST","/v1/auth/logout"); }catch(_){} setToken(""); }

// Households are discovered via the responsibilities the user can see is not enough;
// we track created/joined ones in localStorage for this minimal client only (UI hint,
// never authoritative — every action re-hits the server).
function knownHouseholds(){ return JSON.parse(localStorage.getItem("relay_hh")||"[]"); }
function rememberHousehold(id){ const s=new Set(knownHouseholds()); s.add(id); localStorage.setItem("relay_hh",JSON.stringify([...s])); }
async function loadHouseholds(){
  const ids = knownHouseholds(); const sel=$("hhSelect"); sel.innerHTML="";
  for(const id of ids){ try{ const h=await call("GET","/v1/households/"+id); const o=document.createElement("option"); o.value=h.id; o.textContent=h.name+" ("+h.id.slice(0,8)+")"; sel.appendChild(o);}catch(_){} }
  onHousehold();
}
async function createHousehold(){
  try{ const h=await call("POST","/v1/households",{name:$("hhName").value||"Home"}); rememberHousehold(h.id); await loadHouseholds(); $("hhSelect").value=h.id; onHousehold(); }
  catch(e){ alert("Create household failed: "+e.message); }
}
function currentHH(){ return $("hhSelect").value||null; }
async function onHousehold(){ HH=currentHH(); if(HH){ await members(); await listResp(); await refreshMe(); } }
async function members(){
  if(!HH) return; try{ const m=await call("GET","/v1/households/"+HH+"/members");
    show("members", "<b>Members</b><br>"+m.map(x=>`<span class="pill">${esc(x.role)}</span> ${x.id.slice(0,8)} · user ${x.user_id.slice(0,8)}`).join("<br>"));
  }catch(e){ show("members","(members: "+esc(e.message)+")"); }
}
async function createInvite(){
  if(!HH) return alert("Select a household"); try{ const inv=await call("POST","/v1/households/"+HH+"/invites",{});
    prompt("Invite token (share with the other user):", inv.token); }catch(e){ alert("Invite failed: "+e.message); }
}
async function acceptInvite(){
  try{ const r=await call("POST","/v1/invites/"+$("inviteToken").value+"/accept"); rememberHousehold(r.household_id); await loadHouseholds(); $("hhSelect").value=r.household_id; onHousehold(); alert("Joined household"); }
  catch(e){ alert("Accept failed: "+e.message); }
}

async function draft(){
  if(!HH) return alert("Select a household"); try{
    const d=await call("POST","/v1/responsibilities/drafts?household_id="+HH,{text:$("capture").value});
    const steps=d.steps.map(s=>`<div class="item">${esc(s.kind)} · ${esc(s.description)} <span class="pill">${esc(s.provenance)}</span></div>`).join("");
    show("draftBox", `<div class="item"><b>${esc(d.title)}</b> <span class="pill">${esc(d.provider)}/${esc(d.validation_state)}</span>
      <div class="muted">recurrence: ${esc(d.recurrence_rrule)||"—"} · deadline: ${esc(d.deadline_at)||"—"}</div>
      ${steps}
      <div class="muted">Questions: ${d.clarification_questions.map(esc).join(" ")}</div>
      <button onclick='createFromDraft(${JSON.stringify(JSON.stringify(d))})'>Create responsibility</button></div>`);
  }catch(e){ alert("Draft failed: "+e.message); }
}
async function createFromDraft(js){
  const d=JSON.parse(js);
  const body={ title:d.title, domain:d.domain||"general", completion_standard:d.completion_standard,
    target_at:d.deadline_at, recurrence_rrule:d.recurrence_rrule,
    steps:d.steps.map((s,i)=>({step_key:s.step_key||("step"+i), kind:s.kind, description:s.description, ordering:i, due_at:s.due_at, provenance:s.provenance, is_assumption:s.is_assumption})) };
  try{ const r=await call("POST","/v1/responsibilities?household_id="+HH,body); await listResp(); openResp(r.id); }
  catch(e){ alert("Create failed: "+e.message); }
}

async function listResp(){
  if(!HH) return; try{ const rs=await call("GET","/v1/responsibilities?household_id="+HH);
    show("respList", rs.map(r=>`<div class="item"><b>${esc(r.title)}</b> <span class="pill">${esc(r.status)}</span> <span class="pill">v${r.ownership_version}</span>
      owner ${r.current_owner_membership_id?r.current_owner_membership_id.slice(0,8):"—"}
      <button class="ghost" onclick="openResp('${r.id}')">Open X-Ray</button></div>`).join("")||"<div class=muted>none yet</div>");
  }catch(e){ show("respList","("+esc(e.message)+")"); }
}
async function openResp(id){
  try{
    const r=await call("GET","/v1/responsibilities/"+id);
    const steps=(r.current_cycle?r.current_cycle.steps:[]).map(s=>`<div class="item">${esc(s.kind)} · ${esc(s.description)} <span class="pill">${esc(s.status)}</span>
      <button class="ghost" onclick="completeStep('${id}','${s.id}')">Complete</button>
      <button class="ghost" onclick="reopenStep('${id}','${s.id}')">Reopen</button></div>`).join("");
    const m=await call("GET","/v1/households/"+r.household_id+"/members");
    const opts=m.map(x=>`<option value="${x.id}">${x.id.slice(0,8)} (${esc(x.role)})</option>`).join("");
    const proof=await call("GET","/v1/responsibilities/"+id+"/proof-of-relief").catch(()=>null);
    const hist=await call("GET","/v1/responsibilities/"+id+"/ownership-history").catch(()=>[]);
    show("detail", `<div class="item">
      <div class="row"><b>${esc(r.title)}</b> <span class="pill">${esc(r.status)}</span> <span class="pill">owner ${r.current_owner_membership_id?r.current_owner_membership_id.slice(0,8):"—"}</span> <span class="pill">v${r.ownership_version}/scope ${r.scope_version}</span></div>
      ${steps}
      <div class="row"><b>Hand off to</b> <select id="target">${opts}</select>
        <button onclick="propose('${id}')">Propose handoff</button>
        <button class="ghost" onclick="completeResp('${id}')">Complete</button></div>
      <div class="muted">Recurrence: ${r.recurrence?esc(r.recurrence.rrule):"—"}</div>
      <h2>Proof of Relief</h2><pre>${esc(JSON.stringify(proof,null,2))}</pre>
      <h2>Ownership history</h2><pre>${esc(hist.map(e=>e.event_type+" v"+e.ownership_version).join("\n"))}</pre>
    </div>`);
  }catch(e){ show("detail","("+esc(e.message)+")"); }
}
async function propose(id){
  try{ const c=await call("POST","/v1/responsibilities/"+id+"/handoffs",{target_membership_id:$("target").value});
    prompt("Handoff contract id (the recipient accepts this):", c.id); await openResp(id); await listResp(); }
  catch(e){ alert("Propose failed: "+e.message); }
}
async function acceptHandoff(){
  const cid=prompt("Contract id to accept:"); if(!cid) return;
  try{ const r=await call("POST","/v1/handoffs/"+cid+"/accept",{idempotency_key:"ui-"+cid});
    alert("Accepted. New owner "+r.new_owner_membership_id.slice(0,8)+" at v"+r.ownership_version); await listResp(); await refreshMe(); }
  catch(e){ alert("Accept failed: "+e.message); }
}
async function completeStep(rid,sid){ try{ await call("POST",`/v1/responsibilities/${rid}/steps/${sid}/complete`); openResp(rid);}catch(e){alert(e.message);} }
async function reopenStep(rid,sid){ try{ await call("POST",`/v1/responsibilities/${rid}/steps/${sid}/reopen`); openResp(rid);}catch(e){alert(e.message);} }
async function completeResp(id){ try{ await call("POST",`/v1/responsibilities/${id}/complete`); openResp(id); listResp(); }catch(e){alert(e.message);} }

async function refreshMe(){
  try{ const q=await call("GET","/v1/me/ghost-queue"); show("queue","<b>Ghost queue</b>"+(q.length?q.map(i=>`<div class="item">${esc(i.reminder_type)} · due ${esc(i.scheduled_for)}</div>`).join(""):"<div class=muted>empty</div>")); }catch(e){ show("queue","("+esc(e.message)+")"); }
  try{ const n=await call("GET","/v1/me/notifications"); show("notes","<b>Notifications</b>"+(n.length?n.map(x=>`<div class="item">${esc(x.title)} <button class="ghost" onclick="readNote('${x.id}')">read</button></div>`).join(""):"<div class=muted>none</div>")); }catch(e){ show("notes","("+esc(e.message)+")"); }
}
async function readNote(id){ try{ await call("POST","/v1/notifications/"+id+"/read"); refreshMe(); }catch(e){ alert(e.message);} }

// A global "Accept handoff" affordance.
document.addEventListener("DOMContentLoaded", ()=>{
  const b=document.createElement("button"); b.textContent="Accept a handoff…"; b.className="ghost"; b.onclick=acceptHandoff;
  document.querySelector("header").insertBefore(b, $("api"));
  who(); loadHouseholds();
});
</script>
