# Relay configuration. Copy to `.env` for local development.
# All variables are prefixed RELAY_.

# development | test | production
RELAY_ENVIRONMENT=development

# Postgres is authoritative. Required in every environment.
# Docker Compose default:
RELAY_DATABASE_URL=postgresql://relay:relay@localhost:5432/relay_dev
# Local Homebrew Postgres alternative:
# RELAY_DATABASE_URL=postgresql://postgres@localhost:5432/relay_dev

# Session/token signing key. MUST be a strong (>=32 char) value in production;
# startup fails fast otherwise.
RELAY_SECRET_KEY=dev-insecure-secret-change-me

RELAY_LOG_LEVEL=INFO
RELAY_LOG_JSON=true

# Worker cadence / leasing
RELAY_WORKER_POLL_INTERVAL_S=1.0
RELAY_WORKER_LEASE_SECONDS=60
RELAY_WORKER_HEARTBEAT_SECONDS=5
RELAY_WORKER_MAX_ATTEMPTS=5

# AI extraction (Groq, OpenAI-compatible). Without a key, the deterministic
# fallback is used automatically — the app runs fully without AI configured.
RELAY_AI_PROVIDER=groq
RELAY_GROQ_API_KEY=
RELAY_GROQ_MODEL=llama-3.3-70b-versatile
RELAY_GROQ_BASE_URL=https://api.groq.com/openai/v1
RELAY_AI_TIMEOUT_S=20.0

# Notifications (SMTP; dev uses Mailpit on :1025)
RELAY_SMTP_ENABLED=false
RELAY_SMTP_HOST=localhost
RELAY_SMTP_PORT=1025
RELAY_SMTP_FROM=relay@example.com
